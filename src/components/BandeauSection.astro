---
// En-tête « affiche » d'une section : c'est lui que la moitié cliquée de l'accueil « devient »
// (même transition:name que la porte correspondante).
interface Props { univers: 'code' | 'ecriture'; numero: string; titre: string; intro?: string }
const { univers, numero, titre, intro } = Astro.props;
const lettres = [...titre];
---
<header class={`bandeau-section bandeau--${univers}`} transition:name={`porte-${univers}`}>
  <div class="conteneur">
    <p class="numero font-code">{numero}</p>
    <h1 class="font-affiche" aria-label={titre}>
      {lettres.map((l, i) => <span class="lettre" aria-hidden="true" style={`--i: ${i}`}>{l}</span>)}
    </h1>
    {univers === 'ecriture' && <p class="signature font-signature" aria-hidden="true">Bindjé</p>}
    {intro && <p class="intro">{intro}</p>}
  </div>
</header>

<style>
  .bandeau-section { position: relative; overflow: hidden; padding-block: clamp(36px, 6vw, 72px) clamp(28px, 4vw, 48px); }
  .bandeau--code { background: var(--paper); color: var(--ink); }
  .bandeau--ecriture { background: radial-gradient(ellipse at 75% 20%, var(--brun), var(--ink) 70%); color: var(--text-on-dark); }
  .numero { margin: 0 0 6px; font-size: 13px; letter-spacing: .08em; text-transform: uppercase; opacity: .7; }
  h1 {
    margin: 0; padding-top: .12em; font-weight: 400; line-height: .82; letter-spacing: .01em;
    font-size: clamp(72px, 16vw, 220px); overflow-wrap: anywhere;
  }
  .bandeau--ecriture h1 { color: var(--gold-on-dark); }
  .lettre { display: inline-block; animation: lettre-monte .7s var(--ease-sortie) both; animation-delay: calc(var(--i) * 60ms); }
  .signature { margin: 4px 0 0; font-size: clamp(34px, 4vw, 52px); line-height: 1; }
  .intro { margin: 18px 0 0; max-width: 620px; font-size: 17px; opacity: .85; }
  @keyframes lettre-monte { from { transform: translateY(40%); opacity: 0; } to { transform: none; opacity: 1; } }
</style>
