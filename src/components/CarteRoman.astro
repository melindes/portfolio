---
import type { CollectionEntry } from 'astro:content';
import { localizedPath, useTranslations, type Lang } from '../lib/i18n';
import { slugOf } from '../lib/content';

interface Props { entry: CollectionEntry<'romans'>; lang: Lang }
const { entry, lang } = Astro.props;
const t = useTranslations(lang);
const d = entry.data;
---
<a class="carte-roman" href={localizedPath('roman', lang, slugOf(entry.id))} data-reveal>
  <span class="etat">{t('roman.aVenir')}</span>
  <span class="titre font-titre">{d.titre}</span>
  {d.genres.length > 0 && <span class="genres">{d.genres.join(' · ')}</span>}
</a>

<style>
  .carte-roman {
    display: grid; gap: 8px; align-content: start; min-height: 150px; padding: 22px; border-radius: var(--radius);
    border: 1px dashed var(--border); color: var(--fg); text-decoration: none; transition: transform .25s ease, border-color .25s;
  }
  .carte-roman:hover { transform: translateY(-3px); border-color: var(--accent); }
  .etat { font-size: 12px; color: var(--muted); }
  .titre { font-size: 26px; font-weight: 600; font-style: italic; line-height: 1.15; }
  .genres { font-size: 13px; color: var(--muted); }
</style>
