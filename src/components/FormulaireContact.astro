---
import { MOTIFS } from '../lib/contact';
import { localizedPath, useTranslations, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const cle = import.meta.env.PUBLIC_WEB3FORMS_KEY as string | undefined;
if (!cle) {
  throw new Error('PUBLIC_WEB3FORMS_KEY manquante : crée une clé sur web3forms.com et ajoute-la aux variables d’environnement (voir .env.example).');
}
const emailSecours = (import.meta.env.PUBLIC_CONTACT_EMAIL as string | undefined) || '';
const merci = Astro.site ? new URL(localizedPath('merci', lang), Astro.site).href : '';
const libelles = Object.fromEntries(MOTIFS.map((m) => [m, t(`contact.motifs.${m}`)]));
---
<form
  class="formulaire-contact"
  method="POST"
  action="https://api.web3forms.com/submit"
  data-libelles={JSON.stringify(libelles)}
  data-merci-chemin={localizedPath('merci', lang)}
  data-txt-envoyer={t('contact.envoyer')}
  data-txt-envoi={t('contact.envoi')}
>
  <input type="hidden" name="access_key" value={cle} />
  <input type="hidden" name="subject" value={`[Portfolio] ${libelles.autre}`} />
  <input type="hidden" name="from_name" value="Portfolio Melindes · Bindjé" />
  {merci && <input type="hidden" name="redirect" value={merci} />}
  <input type="hidden" name="oeuvre" value="" />
  <input type="checkbox" name="botcheck" class="piege" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <label for="champ-nom">{t('contact.nom')}</label>
  <input id="champ-nom" name="nom" type="text" required autocomplete="name" maxlength="120" />

  <label for="champ-email">{t('contact.email')}</label>
  <input id="champ-email" name="email" type="email" required autocomplete="email" maxlength="200" />

  <label for="champ-motif">{t('contact.motif')}</label>
  <select id="champ-motif" name="motif">
    {MOTIFS.map((m) => <option value={m} selected={m === 'autre'}>{libelles[m]}</option>)}
  </select>

  <label for="champ-message">{t('contact.message')}</label>
  <textarea id="champ-message" name="message" rows="7" required maxlength="5000"></textarea>

  <button class="bouton bouton--plein" type="submit">{t('contact.envoyer')}</button>

  <div class="retour" role="status" aria-live="polite">
    <p class="succes" hidden>{t('contact.succes')}</p>
    <p class="erreur" hidden>
      {t('contact.erreur')}
      {emailSecours
        ? <> {t('contact.erreurEmail')} <a href={`mailto:${emailSecours}`}>{emailSecours}</a></>
        : <> {t('contact.erreurPlusTard')}</>}
    </p>
  </div>
</form>

<style>
  .formulaire-contact { display: grid; gap: 6px; max-width: 560px; }
  label { font-size: 14px; font-weight: 600; margin-top: 10px; }
  input, select, textarea {
    font: inherit; color: var(--fg); background: var(--surface); border: 1px solid var(--border);
    border-radius: 8px; padding: 10px 12px; width: 100%;
  }
  input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  textarea { resize: vertical; }
  .piege { display: none; }
  button { margin-top: 16px; justify-self: start; border: none; font-weight: 600; padding: 11px 22px; }
  button[disabled] { opacity: .6; cursor: wait; }
  .retour p { margin: 10px 0 0; }
  .succes { color: var(--fg); font-weight: 600; }
  .erreur { color: var(--fg); border-left: 3px solid #d0453a; padding-left: 10px; }
</style>

<script>
  import { buildSubject, parseContactParams, type Motif } from '../lib/contact';

  const DELAI_MAX_MS = 15_000;

  function init() {
    const form = document.querySelector<HTMLFormElement>('.formulaire-contact');
    if (!form || form.dataset.pret) return;
    form.dataset.pret = '1';

    const libelles = JSON.parse(form.dataset.libelles ?? '{}') as Record<Motif, string>;
    const select = form.querySelector<HTMLSelectElement>('select[name="motif"]')!;
    const oeuvre = form.querySelector<HTMLInputElement>('input[name="oeuvre"]')!;
    const sujet = form.querySelector<HTMLInputElement>('input[name="subject"]')!;
    const nom = form.querySelector<HTMLInputElement>('input[name="nom"]')!;
    const bouton = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const succes = form.querySelector<HTMLElement>('.succes')!;
    const erreur = form.querySelector<HTMLElement>('.erreur')!;

    const { motif, oeuvre: o } = parseContactParams(window.location.search);
    select.value = motif;
    oeuvre.value = o ?? '';

    let redirect = form.querySelector<HTMLInputElement>('input[name="redirect"]');
    if (!redirect) {
      redirect = document.createElement('input');
      redirect.type = 'hidden';
      redirect.name = 'redirect';
      form.append(redirect);
    }
    redirect.value = new URL(form.dataset.merciChemin ?? '/', window.location.origin).href;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      sujet.value = buildSubject(libelles[select.value as Motif] ?? select.value, nom.value);
      succes.hidden = true;
      erreur.hidden = true;
      bouton.disabled = true;
      bouton.textContent = form.dataset.txtEnvoi ?? '…';
      try {
        const donnees = Object.fromEntries(new FormData(form));
        delete donnees.redirect;
        // Délai maximal : sur un réseau qui ne répond pas, on rend la main au visiteur.
        const controle = new AbortController();
        const minuterie = window.setTimeout(() => controle.abort(), DELAI_MAX_MS);
        const rep = await fetch(form.action, {
          signal: controle.signal,
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(donnees),
        }).finally(() => window.clearTimeout(minuterie));
        const json = (await rep.json().catch(() => ({}))) as { success?: boolean };
        if (!rep.ok || !json.success) throw new Error('refus');
        form.reset();
        select.value = 'autre';
        succes.hidden = false;
      } catch {
        erreur.hidden = false;
      } finally {
        bouton.disabled = false;
        bouton.textContent = form.dataset.txtEnvoyer ?? '';
      }
    });
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
