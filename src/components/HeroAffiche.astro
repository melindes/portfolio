---
import { Image } from 'astro:assets';
import portrait from '../assets/portrait-detoure.png';
import { localizedPath, useTranslations, type Lang } from '../lib/i18n';

interface Props { lang: Lang; sousTitreMelindes: string; sousTitreBindje: string }
const { lang, sousTitreMelindes, sousTitreBindje } = Astro.props;
const t = useTranslations(lang);
---
<section class="affiche" data-state="done" aria-label="Portfolio — Melindes · Bindjé">
  <div class="scene">
    <!-- Les deux moitiés du fond : c'est elles que « la porte s'ouvre » transforme en bandeau de section. -->
    <span class="moitie moitie--code" transition:name="porte-code" aria-hidden="true"></span>
    <span class="moitie moitie--ecriture" transition:name="porte-ecriture" aria-hidden="true"></span>
    <p class="mot font-affiche" aria-hidden="true"><span class="g">POR</span><span class="t">T</span><span class="d">FOLIO</span></p>
    <Image class="photo" src={portrait} alt={t('accueil.portraitAlt')} widths={[300, 460, 700]} sizes="(max-width: 719px) 60vw, 460px" loading="eager" fetchpriority="high" />
  </div>
  <div class="portes">
    <a class="porte porte--code" href={localizedPath('code', lang)}>
      <span class="trait" aria-hidden="true"></span>
      <span class="devise font-code">{t('accueil.melindesResout')}</span>
      <span class="sous-titre">{sousTitreMelindes}</span>
      <span class="appel">{t('accueil.voirCode')}</span>
    </a>
    <a class="porte porte--ecriture" href={localizedPath('ecriture', lang)}>
      <span class="trait" aria-hidden="true"></span>
      <span class="devise font-signature">{t('accueil.bindjeRaconte')}</span>
      <span class="sous-titre">{sousTitreBindje}</span>
      <span class="appel">{t('accueil.lireHistoires')}</span>
    </a>
  </div>
</section>
<script is:inline>
  (function () {
    var a = document.querySelector('.affiche'), vu = null;
    if (!a) return;
    try { vu = sessionStorage.getItem('intro-vue'); } catch (e) {}
    if (vu !== '1' && !matchMedia('(prefers-reduced-motion: reduce)').matches) a.dataset.state = 'playing';
  })();
</script>

<style>
  .affiche { position: relative; isolation: isolate; min-height: min(88vh, 780px); display: grid; overflow: hidden; }
  .scene, .portes { grid-area: 1 / 1; }

  .scene { position: relative; overflow: hidden; }
  .moitie { position: absolute; top: 0; bottom: 0; width: 50%; }
  .moitie--code { left: 0; background: var(--paper); }
  .moitie--ecriture { right: 0; background: var(--ink); }

  .mot {
    position: absolute; z-index: 1; top: 3%; left: 0; right: 0; margin: 0; display: flex;
    font-size: clamp(64px, 15.5vw, 230px); line-height: .82; letter-spacing: .01em; pointer-events: none;
  }
  .mot .g { flex: 1; text-align: right; color: var(--ink); }
  .mot .d { flex: 1; text-align: left; color: var(--gold-on-dark); }
  .mot .t {
    background: linear-gradient(90deg, var(--ink) 50%, var(--gold-on-dark) 50%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }

  .photo {
    position: absolute; z-index: 2; left: 50%; bottom: 0; transform: translateX(-50%);
    height: 84%; width: auto; max-width: none; pointer-events: none;
    filter: drop-shadow(0 18px 30px rgb(0 0 0 / .35));
  }

  .portes { position: relative; z-index: 3; display: flex; }
  .porte {
    flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: flex-end; gap: 6px;
    padding: 0 clamp(16px, 3vw, 40px) 40px; text-decoration: none;
  }
  .porte--code { align-items: flex-start; color: var(--ink); --or: var(--gold-on-light); }
  .porte--ecriture { align-items: flex-end; text-align: right; color: var(--text-on-dark); --or: var(--gold-on-dark); }
  .porte:focus-visible { outline: 2px solid var(--or); outline-offset: -8px; }
  .trait { width: 34px; height: 3px; background: var(--gold-on-dark); margin-bottom: 4px; }
  .devise.font-code { font-size: clamp(16px, 1.6vw, 20px); }
  .devise.font-signature { font-size: clamp(30px, 3vw, 40px); line-height: 1; }
  .sous-titre { font-size: 13px; opacity: .75; }
  .appel {
    margin-top: 8px; font-size: 14px; padding: 8px 16px; border-radius: 999px; border: 1px solid var(--or); color: var(--or);
    transition: background .25s ease, color .25s ease;
  }
  .porte:hover .appel { background: var(--or); color: var(--paper); }
  .porte--ecriture:hover .appel { color: var(--ink); }

  /* — Entrée de l'affiche (≈ 2 s), une fois par visite — */
  .affiche[data-state='playing'] .mot .g { animation: depuis-gauche .9s cubic-bezier(.2, .7, .2, 1) .1s both; }
  .affiche[data-state='playing'] .mot .d { animation: depuis-droite .9s cubic-bezier(.2, .7, .2, 1) .1s both; }
  .affiche[data-state='playing'] .mot .t { animation: apparait .5s ease .8s both; }
  .affiche[data-state='playing'] .photo { animation: monte .9s cubic-bezier(.2, .7, .2, 1) .9s both; }
  .affiche[data-state='playing'] .porte > * { animation: apparait .5s ease 1.5s both; }

  @keyframes depuis-gauche { from { transform: translateX(-60%); opacity: 0; } to { transform: none; opacity: 1; } }
  @keyframes depuis-droite { from { transform: translateX(60%); opacity: 0; } to { transform: none; opacity: 1; } }
  @keyframes apparait { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @keyframes monte { from { opacity: 0; transform: translate(-50%, 14%); } to { opacity: 1; transform: translateX(-50%); } }

  /* Mobile : l'affiche en haut, les deux portes en dessous (côte à côte). */
  @media (max-width: 719px) {
    .affiche { min-height: 0; grid-template-rows: auto auto; }
    .scene { grid-area: 1 / 1; height: min(78vh, 560px); }
    .portes { grid-area: 2 / 1; }
    .mot { top: 4%; font-size: clamp(48px, 17vw, 110px); }
    .photo { height: 78%; }
    .porte { padding: 22px 12px 26px; }
    .devise.font-code { font-size: 14px; }
    .devise.font-signature { font-size: 26px; }
    .porte--code { background: var(--paper); }
    .porte--ecriture { background: var(--ink); }
    .sous-titre { font-size: 12px; }
    .appel { font-size: 13px; padding: 7px 12px; }
  }
</style>

<script>
  import { markIntroSeen } from '../lib/intro';

  function init() {
    const affiche = document.querySelector<HTMLElement>('.affiche');
    if (!affiche || affiche.dataset.state !== 'playing') return;
    let stockage: Storage | undefined;
    try { stockage = window.sessionStorage; } catch { stockage = undefined; }
    markIntroSeen(stockage);
    const finir = () => { affiche.dataset.state = 'done'; };
    affiche.querySelector('.photo')?.addEventListener('animationend', finir, { once: true });
    window.setTimeout(finir, 3500);
  }
  init();
  document.addEventListener('astro:page-load', init);
</script>
