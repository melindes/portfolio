---
import { Image } from 'astro:assets';
import portrait from '../assets/portrait-detoure.png';
import Defilant from './Defilant.astro';
import { localizedPath, useTranslations, type Lang } from '../lib/i18n';

interface Props { lang: Lang; nom: string; sousTitreMelindes: string; sousTitreBindje: string }
const { lang, nom, sousTitreMelindes, sousTitreBindje } = Astro.props;
const t = useTranslations(lang);
const mots = t('accueil.defilant').split(' ✦ ');
---
<section class="affiche" data-state="done" aria-label="Portfolio — Melindes · Bindjé">
  <div class="conteneur cadre">
    <div class="titres">
      <p class="identite font-affiche">{nom}</p>
      <p class="mot font-affiche" aria-hidden="true"><span class="haut">PORT</span><span class="bas">FOLIO</span></p>
    </div>
    <Image class="photo" src={portrait} alt={t('accueil.portraitAlt')} widths={[300, 460, 700]} sizes="(max-width: 719px) 70vw, 460px" loading="eager" fetchpriority="high" />
    <div class="portes">
      <a class="porte porte--code" href={localizedPath('code', lang)} transition:name="porte-code">
        <span class="devise font-code">{t('accueil.melindesResout')}</span>
        <span class="sous-titre">{sousTitreMelindes}</span>
        <span class="appel">{t('accueil.voirCode')}</span>
      </a>
      <a class="porte porte--ecriture" href={localizedPath('ecriture', lang)} transition:name="porte-ecriture">
        <span class="devise font-signature">{t('accueil.bindjeRaconte')}</span>
        <span class="sous-titre">{sousTitreBindje}</span>
        <span class="appel">{t('accueil.lireHistoires')}</span>
      </a>
    </div>
  </div>
  <Defilant mots={mots} variante="or" />
</section>
<script is:inline>
  (function () {
    var a = document.querySelector('.affiche'), vu = null;
    if (!a) return;
    try { vu = sessionStorage.getItem('intro-vue'); } catch (e) {}
    if (vu !== '1' && !matchMedia('(prefers-reduced-motion: reduce)').matches) a.dataset.state = 'playing';
  })();
</script>

<style>
  .affiche {
    position: relative; overflow: hidden; display: grid; grid-template-rows: 1fr auto;
    min-height: min(88vh, 820px); color: var(--text-on-dark);
    background: radial-gradient(ellipse at 72% 45%, #4a2410 0%, var(--ink) 62%);
  }
  .cadre {
    display: grid; align-items: end; column-gap: clamp(16px, 4vw, 56px);
    grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr);
    grid-template-areas: 'titres photo' 'portes photo';
    padding-top: clamp(28px, 5vw, 64px);
  }
  .titres { grid-area: titres; align-self: center; }
  .identite { margin: 0 0 10px; font-size: clamp(13px, 1.3vw, 18px); letter-spacing: .14em; text-transform: uppercase; color: #c9b8a6; }
  .mot { margin: 0; display: grid; font-size: clamp(96px, 15vw, 240px); line-height: .8; letter-spacing: .01em; }
  .haut { color: var(--paper); }
  .bas { color: var(--gold-on-dark); }

  .photo {
    grid-area: photo; justify-self: center; align-self: end; width: auto; max-width: 100%;
    height: min(78vh, 700px); object-fit: contain; object-position: bottom;
    filter: drop-shadow(0 24px 40px rgb(0 0 0 / .55));
  }

  .portes { grid-area: portes; display: flex; flex-wrap: wrap; gap: 14px; padding: clamp(22px, 3vw, 36px) 0 clamp(28px, 4vw, 48px); }
  .porte {
    display: grid; gap: 2px; min-width: min(100%, 240px); padding: 14px 22px; border-radius: 18px; text-decoration: none;
    transition: transform .3s var(--ease-sortie), box-shadow .3s var(--ease-sortie), background .3s ease;
  }
  .porte:hover { transform: translateY(-3px); box-shadow: 0 14px 30px rgb(0 0 0 / .35); }
  .porte--code { background: var(--paper); color: var(--ink); }
  .porte--ecriture { border: 1px solid var(--gold-on-dark); color: var(--gold-on-dark); }
  .porte--ecriture:hover { background: rgb(242 183 5 / .1); }
  .porte:focus-visible { outline: 2px solid var(--gold-on-dark); outline-offset: 3px; }
  .devise.font-code { font-size: 15px; }
  .devise.font-signature { font-size: 30px; line-height: 1; }
  .sous-titre { font-size: 12px; opacity: .75; }
  .appel { margin-top: 4px; font-weight: 600; font-size: 15px; }

  /* — Entrée de l'affiche (≈ 2 s), une fois par visite — */
  .affiche[data-state='playing'] .identite { animation: apparait .5s ease .1s both; }
  .affiche[data-state='playing'] .haut { animation: depuis-gauche .8s var(--ease-sortie) .15s both; }
  .affiche[data-state='playing'] .bas { animation: depuis-gauche .8s var(--ease-sortie) .35s both; }
  .affiche[data-state='playing'] .photo { animation: monte 1s var(--ease-sortie) .5s both; }
  .affiche[data-state='playing'] .porte { animation: apparait .5s ease 1.1s both; }

  @keyframes depuis-gauche { from { transform: translateX(-30%); opacity: 0; } to { transform: none; opacity: 1; } }
  @keyframes apparait { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @keyframes monte { from { opacity: 0; transform: translateY(12%); } to { opacity: 1; transform: none; } }

  /* Mobile : titre, puis photo, puis les deux portes empilées. */
  @media (max-width: 719px) {
    .affiche { min-height: 0; }
    .cadre { grid-template-columns: 1fr; grid-template-areas: 'titres' 'photo' 'portes'; padding-top: 24px; }
    .mot { font-size: clamp(76px, 29vw, 150px); }
    .photo { height: min(62vh, 480px); margin-top: -12px; }
    .portes { flex-direction: column; padding-top: 18px; }
    .porte { min-width: 0; }
  }
</style>

<script>
  import { markIntroSeen } from '../lib/intro';

  function init() {
    const affiche = document.querySelector<HTMLElement>('.affiche');
    if (!affiche || affiche.dataset.state !== 'playing') return;
    let stockage: Storage | undefined;
    try { stockage = window.sessionStorage; } catch { stockage = undefined; }
    markIntroSeen(stockage);
    const finir = () => { affiche.dataset.state = 'done'; };
    affiche.querySelector('.photo')?.addEventListener('animationend', finir, { once: true });
    window.setTimeout(finir, 3500);
  }
  init();
  document.addEventListener('astro:page-load', init);
</script>
