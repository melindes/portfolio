---
import { localizedPath, useTranslations, type Lang } from '../lib/i18n';

interface Props { lang: Lang; sousTitreMelindes: string; sousTitreBindje: string }
const { lang, sousTitreMelindes, sousTitreBindje } = Astro.props;
const t = useTranslations(lang);
---
<section class="relais" data-state="done" aria-label="Melindes · Bindjé">
  <a class="porte porte--code" href={localizedPath('code', lang)} transition:name="porte-code">
    <span class="nom-code font-code"><span class="tape">Melindes</span><span class="curseur" aria-hidden="true"></span></span>
    <span class="sous-titre">{sousTitreMelindes}</span>
    <span class="appel">{t('accueil.voirCode')}</span>
  </a>
  <a class="porte porte--ecriture" href={localizedPath('ecriture', lang)} transition:name="porte-ecriture">
    <svg class="signature" viewBox="0 0 320 100" role="img" aria-label="Bindjé">
      <text x="160" y="72" text-anchor="middle">Bindjé</text>
    </svg>
    <span class="sous-titre">{sousTitreBindje}</span>
    <span class="appel">{t('accueil.lireHistoires')}</span>
  </a>
  <span class="etincelle" aria-hidden="true"></span>
  <p class="phrase"><span class="phrase-g">{t('accueil.melindesResout')}</span> <span class="phrase-d">{t('accueil.bindjeRaconte')}</span></p>
  <p class="phrase-or font-titre">{t('accueil.deuxFacons')}</p>
</section>
<script is:inline>
  (function () {
    var r = document.querySelector('.relais'), vu = null;
    if (!r) return;
    try { vu = sessionStorage.getItem('intro-vue'); } catch (e) {}
    if (vu !== '1' && !matchMedia('(prefers-reduced-motion: reduce)').matches) r.dataset.state = 'playing';
  })();
</script>

<style>
  .relais {
    position: relative; display: flex; min-height: min(86vh, 760px); overflow: hidden;
  }
  .porte {
    position: relative; flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 12px; padding: 48px 24px 140px; text-decoration: none; text-align: center;
    transition: flex .5s ease;
  }
  .porte:hover, .porte:focus-visible { flex: 1.7; }
  .porte--code { background: var(--paper); color: var(--ink); --or: var(--gold-on-light); }
  .porte--ecriture { background: var(--ink); color: var(--text-on-dark); --or: var(--gold-on-dark); }
  .porte:focus-visible { outline: 2px solid var(--or); outline-offset: -6px; }

  .nom-code { font-size: clamp(30px, 4.4vw, 52px); display: inline-flex; align-items: center; }
  .tape { display: inline-block; overflow: hidden; white-space: nowrap; vertical-align: bottom; }
  .curseur { width: 3px; height: 1em; margin-left: 4px; background: currentColor; opacity: 0; }
  .signature { width: min(100%, 340px); height: auto; overflow: visible; }
  .signature text {
    font-family: Allura, cursive; font-size: 88px; fill: var(--text-on-dark);
    stroke: var(--text-on-dark); stroke-width: 1; stroke-dasharray: 900; stroke-dashoffset: 0;
  }
  .sous-titre { font-size: 13px; letter-spacing: .5px; opacity: .7; }
  .appel { margin-top: 6px; font-size: 14px; padding: 8px 16px; border-radius: 999px; border: 1px solid var(--or); color: var(--or); }

  .etincelle {
    position: absolute; top: 44%; left: calc(50% - 5px); width: 10px; height: 10px; border-radius: 50%;
    background: var(--gold-on-dark); box-shadow: 0 0 16px 4px var(--gold-on-dark); opacity: 0; pointer-events: none;
  }
  .phrase {
    position: absolute; left: 0; right: 0; bottom: 72px; margin: 0; display: flex; pointer-events: none; font-size: 16px;
  }
  .phrase span { flex: 1; }
  .phrase-g { text-align: right; padding-right: 8px; color: var(--ink); }
  .phrase-d { text-align: left; padding-left: 8px; color: var(--text-on-dark); }
  .phrase-or {
    position: absolute; left: 50%; bottom: 22px; transform: translateX(-50%); margin: 0; white-space: nowrap;
    font-size: 20px; font-style: italic; color: var(--gold-on-dark); background: var(--ink);
    padding: 4px 18px; border-radius: 999px; border: 1px solid #3a3222; pointer-events: none;
  }

  /* — Séquence du relais (≈ 5 s), uniquement quand data-state="playing" — */
  .relais[data-state='playing'] .tape { animation: taper 1.2s steps(8) .2s both; }
  .relais[data-state='playing'] .curseur { animation: clignote .7s steps(1) 0s 3, efface .2s 2s forwards; }
  .relais[data-state='playing'] .etincelle { animation: traverse .9s cubic-bezier(.5, 0, .3, 1) 1.4s both; }
  .relais[data-state='playing'] .signature text { animation: tracer 1.6s ease-in-out 2s both, encrer .6s ease 3.4s both; }
  .relais[data-state='playing'] .sous-titre,
  .relais[data-state='playing'] .appel { animation: apparait .6s ease 3.7s both; }
  .relais[data-state='playing'] .phrase { animation: apparait .6s ease 4.1s both; }
  .relais[data-state='playing'] .phrase-or { animation: apparait-or .6s ease 4.5s both; }

  @keyframes taper { from { max-width: 0; } to { max-width: 9ch; } }
  @keyframes clignote { 0% { opacity: 1; } 50% { opacity: 0; } }
  @keyframes efface { to { opacity: 0; } }
  @keyframes traverse {
    0% { left: 38%; opacity: 0; } 15% { opacity: 1; } 85% { opacity: 1; } 100% { left: 62%; opacity: 0; }
  }
  @keyframes tracer { from { stroke-dashoffset: 900; fill-opacity: 0; } to { stroke-dashoffset: 0; fill-opacity: 0; } }
  @keyframes encrer { from { fill-opacity: 0; } to { fill-opacity: 1; } }
  @keyframes apparait { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @keyframes apparait-or { from { opacity: 0; transform: translate(-50%, 6px); } to { opacity: 1; transform: translateX(-50%); } }

  @media (max-width: 719px) {
    .relais { flex-direction: column; min-height: auto; }
    .porte { padding: 40px 16px; min-height: 38vh; }
    .porte--ecriture { padding-bottom: 150px; }
    .porte:hover, .porte:focus-visible { flex: 1; }
    .etincelle { display: none; }
    .phrase { bottom: 76px; flex-direction: column; align-items: center; gap: 2px; }
    .phrase-g, .phrase-d { text-align: center; padding: 0; color: var(--text-on-dark); }
    .phrase-or { white-space: normal; text-align: center; max-width: calc(100% - 32px); }
  }
</style>

<script>
  import { markIntroSeen } from '../lib/intro';

  function init() {
    const relais = document.querySelector<HTMLElement>('.relais');
    if (!relais || relais.dataset.state !== 'playing') return;
    let stockage: Storage | undefined;
    try { stockage = window.sessionStorage; } catch { stockage = undefined; }
    markIntroSeen(stockage);
    const finir = () => { relais.dataset.state = 'done'; };
    relais.querySelector('.phrase-or')?.addEventListener('animationend', finir, { once: true });
    window.setTimeout(finir, 6000);
  }
  init();
  document.addEventListener('astro:page-load', init);
</script>
