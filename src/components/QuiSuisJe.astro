---
import { useTranslations, type Lang } from '../lib/i18n';

interface Props { lang: Lang; nom: string; diplome: string; paragraphes: string[] }
const { lang, nom, diplome, paragraphes } = Astro.props;
const t = useTranslations(lang);
---
<section class="qui-suis-je" aria-labelledby="qui-nom">
  <div class="frontiere" data-reveal>
    <p class="deux font-titre">{t('accueil.deuxFacons')}</p>
    <h2 id="qui-nom" class="nom">{nom} <span class="diplome">· {diplome}</span></h2>
  </div>
  <div class="texte conteneur" data-reveal>
    {paragraphes.map((p) => <p>{p}</p>)}
  </div>
</section>

<style>
  .frontiere {
    background: linear-gradient(90deg, var(--paper) 50%, var(--ink) 50%);
    display: flex; flex-direction: column; align-items: center; gap: 14px; padding: 44px 16px; text-align: center;
  }
  .deux, .nom { background: var(--ink); color: var(--gold-on-dark); border: 1px solid #3a3222; border-radius: 999px; margin: 0; max-width: 100%; }
  .deux { font-style: italic; font-size: 20px; padding: 4px 18px; }
  .nom { font-size: clamp(20px, 3vw, 28px); padding: 6px 20px; }
  .diplome { font-weight: 500; }
  .texte { max-width: 680px; padding-block: 28px 8px; font-size: 17px; text-align: center; }
  @media (max-width: 719px) { .nom, .deux { border-radius: 14px; } }
</style>
