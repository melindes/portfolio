---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';
import Header, { type Univers } from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Reveal from '../components/Reveal.astro';
import { ClientRouter } from 'astro:transitions';
import { getImage } from 'astro:assets';
import icone from '../assets/melindes/icone.png';
import { alternatePath, otherLang, useTranslations, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Thème par défaut de l'univers ; 'split' = accueil (héros coupé blanc/noir). */
  theme: 'clair' | 'sombre' | 'split';
  univers?: Univers;
}

const { lang, title, description, theme, univers = 'neutre' } = Astro.props;
const t = useTranslations(lang);
const themeDefaut = theme === 'split' ? 'clair' : theme;
const titreComplet = title ? `${title} · ${t('site.titre')}` : t('site.titre');
const ici = Astro.url.pathname;
// Côté Code, l'onglet prend l'icône de Melindes développeur.
const faviconCode = univers === 'code' ? await getImage({ src: icone, width: 64, height: 64, format: 'png' }) : null;
const ailleurs = alternatePath(ici);
const absolu = (chemin: string) => (Astro.site ? new URL(chemin, Astro.site).href : chemin);
---
<!doctype html>
<html lang={lang} data-theme={themeDefaut} data-theme-defaut={themeDefaut} data-split={theme === 'split' ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description ?? t('site.description')} />
    {faviconCode
      ? <link rel="icon" type="image/png" href={faviconCode.src} />
      : <link rel="icon" type="image/svg+xml" href="/favicon.svg" />}
    {Astro.site && <link rel="canonical" href={absolu(ici)} />}
    <link rel="alternate" hreflang={lang} href={absolu(ici)} />
    <link rel="alternate" hreflang={otherLang(lang)} href={absolu(ailleurs)} />
    <script is:inline>
      (function () {
        function appliquer(d) {
          var s = null;
          // Un choix par univers : clair par défaut (Code) ou sombre par défaut (Écriture).
          try { s = localStorage.getItem('theme:' + d.dataset.themeDefaut); } catch (e) {}
          d.dataset.theme = s === 'clair' || s === 'sombre' ? s : d.dataset.themeDefaut;
          if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('js-reveal');
        }
        appliquer(document.documentElement);
        if (!window.__themeHook) {
          window.__themeHook = true;
          // Le routeur remplace les attributs de <html> à chaque navigation : on réapplique le choix.
          document.addEventListener('astro:after-swap', function () { appliquer(document.documentElement); });
        }
      })();
    </script>
    <ClientRouter fallback="animate" />
    <slot name="head" />
  </head>
  <body>
    <Header lang={lang} univers={univers} />
    <slot />
    <Footer lang={lang} />
    <Reveal />
  </body>
</html>
