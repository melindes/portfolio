---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroAffiche from '../components/HeroAffiche.astro';
import Recit from '../components/Recit.astro';
import RejoindreBandeau from '../components/RejoindreBandeau.astro';
import { getAccueil } from '../lib/content';
import type { Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const accueil = await getAccueil(lang);
---
<BaseLayout lang={lang} theme="split">
  <main>
    <h1 class="sr-only">{accueil.nom} — Portfolio Melindes · Bindjé</h1>
    <HeroAffiche lang={lang} nom={accueil.nom} sousTitreMelindes={accueil.sous_titre_melindes} sousTitreBindje={accueil.sous_titre_bindje} />
    <Recit lang={lang} />
    <RejoindreBandeau lang={lang} />
  </main>
</BaseLayout>
