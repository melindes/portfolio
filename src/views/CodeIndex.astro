---
import BaseLayout from '../layouts/BaseLayout.astro';
import BandeauSection from '../components/BandeauSection.astro';
import CeQueJeFais from '../components/CeQueJeFais.astro';
import CarteProjet from '../components/CarteProjet.astro';
import { listLocalized, getCompetences } from '../lib/content';
import { localizedPath, useTranslations, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const projets = await listLocalized('projets', lang);
const { technos } = await getCompetences();
---
<BaseLayout lang={lang} title={t('code.titre')} theme="clair" univers="code">
  <main>
    <BandeauSection univers="code" titre="Melindes" intro={t('code.intro')} />
    <div class="conteneur">
      <CeQueJeFais univers="code" lang={lang} />

      <section class="projets" aria-labelledby="titre-projets">
        <h2 id="titre-projets">{t('code.projets')}</h2>
        <div class="grille">
          {projets.map(({ entry }) => <CarteProjet entry={entry} lang={lang} />)}
        </div>
      </section>

      <section class="competences" aria-labelledby="titre-competences" data-reveal>
        <h2 id="titre-competences">{t('code.competences')}</h2>
        <ul class="font-code">{technos.map((x) => <li>{x}</li>)}</ul>
      </section>

      <p class="contact"><a class="bouton bouton--plein" href={`${localizedPath('contact', lang)}?motif=recrutement`}>{t('code.contactRecrutement')}</a></p>
    </div>
  </main>
</BaseLayout>

<style>
  h2 { font-size: 26px; margin: 40px 0 14px; }
  .grille { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); }
  .competences ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .competences li { font-size: 13px; padding: 6px 12px; border: 1px solid var(--border); border-radius: 6px; }
  .contact { margin-top: 36px; }
</style>
