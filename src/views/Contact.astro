---
import BaseLayout from '../layouts/BaseLayout.astro';
import FormulaireContact from '../components/FormulaireContact.astro';
import { localizedPath, useTranslations, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<BaseLayout lang={lang} title={t('contact.titre')} theme="clair">
  <main class="conteneur page-contact">
    <div class="presentation">
      <h1>{t('contact.titre')}</h1>
      <p class="intro">{t('contact.intro')}</p>
      <div class="raccourcis">
        <a class="raccourci raccourci--code" href={`${localizedPath('contact', lang)}?motif=recrutement`}>
          <span class="titre">{t('contact.raccourciCode')}</span>
          <span class="texte">{t('contact.raccourciCodeTexte')}</span>
        </a>
        <a class="raccourci raccourci--ecriture" href={`${localizedPath('contact', lang)}?motif=beta-lecture`}>
          <span class="titre font-signature">{t('contact.raccourciEcriture')}</span>
          <span class="texte">{t('contact.raccourciEcritureTexte')}</span>
        </a>
      </div>
    </div>
    <FormulaireContact lang={lang} />
  </main>
</BaseLayout>

<style>
  .page-contact {
    display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(24px, 5vw, 72px);
    align-items: start; padding-block: clamp(32px, 5vw, 64px);
  }
  h1 { font-size: clamp(48px, 8vw, 96px); margin: 0 0 10px; }
  .intro { color: var(--muted); max-width: 460px; margin: 0 0 24px; }
  .raccourcis { display: grid; gap: 12px; max-width: 460px; }
  .raccourci {
    display: grid; gap: 2px; padding: 16px 20px; border-radius: var(--radius); text-decoration: none;
    transition: transform .25s var(--ease-sortie), box-shadow .25s var(--ease-sortie);
  }
  .raccourci:hover { transform: translateY(-3px); box-shadow: 0 12px 26px rgb(0 0 0 / .18); }
  .raccourci .texte { font-size: 14px; opacity: .8; }
  /* Chaque raccourci porte l'identité de son univers. */
  .raccourci--code { background: var(--code-blanc); color: var(--code-noir); border: 1px solid #e5e5e5; border-left: 5px solid var(--code-orange); }
  .raccourci--code .titre { font: 800 20px/1.2 var(--police-code); }
  .raccourci--ecriture { background: #14110f; color: #f5efe4; border: 1px solid #2e2722; border-left: 5px solid var(--ecriture-or); }
  .raccourci--ecriture .titre { font-size: 30px; line-height: 1.1; color: var(--ecriture-or); }
  @media (max-width: 860px) { .page-contact { grid-template-columns: 1fr; } }
</style>
