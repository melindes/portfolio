---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import BandeauSection from '../components/BandeauSection.astro';
import CeQueJeFais from '../components/CeQueJeFais.astro';
import CarteRoman from '../components/CarteRoman.astro';
import { listLocalized, slugOf } from '../lib/content';
import { localizedPath, useTranslations, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const romans = await listLocalized('romans', lang);
const phare = romans.find((r) => r.entry.data.statut === 'phare');
const aVenir = romans.filter((r) => r.entry.data.statut === 'a-venir');
---
<BaseLayout lang={lang} title={t('ecriture.titre')} theme="sombre" univers="ecriture">
  <main>
    <BandeauSection univers="ecriture" titre="Bindjé" intro={t('ecriture.intro')} />
    <div class="conteneur">
      <CeQueJeFais univers="ecriture" lang={lang} />

      {phare && (
        <a class="phare" href={localizedPath('roman', lang, slugOf(phare.entry.id))} data-reveal
           style={phare.entry.data.couleur ? `--roman-clair: ${phare.entry.data.couleur.clair}; --roman-sombre: ${phare.entry.data.couleur.sombre}` : undefined}>
          {phare.entry.data.couverture && (
            <Image class="couverture" src={phare.entry.data.couverture} alt={`${t('roman.couvertureAlt')} — ${phare.entry.data.titre}`} widths={[180, 360]} sizes="180px" />
          )}
          <span class="texte">
            <span class="etat">{t('roman.projetPhare')}</span>
            <span class="titre font-titre">{phare.entry.data.titre}</span>
            {phare.entry.data.sous_titre_en && lang === 'en' && <span class="sous-titre">{phare.entry.data.sous_titre_en}</span>}
            <span class="genres">{phare.entry.data.genres.join(' · ')}</span>
            <span class="lien">{t('ecriture.lireFiche')} →</span>
          </span>
        </a>
      )}

      <div class="grille">
        {aVenir.map(({ entry }) => <CarteRoman entry={entry} lang={lang} />)}
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .phare {
    display: flex; gap: 28px; align-items: center; margin-top: 12px; padding: 24px; border-radius: 14px;
    border: 1px solid var(--border); background: var(--surface); color: var(--fg); text-decoration: none;
  }
  :global([data-theme='sombre']) .phare { --roman: var(--roman-sombre); }
  :global([data-theme='clair']) .phare { --roman: var(--roman-clair); }
  .couverture { width: 160px; flex: none; border-radius: 4px; box-shadow: 0 12px 30px rgb(0 0 0 / .35); }
  .texte { display: grid; gap: 8px; }
  .etat { font-size: 12px; color: var(--roman); }
  .titre { font-size: clamp(32px, 5vw, 44px); font-weight: 600; color: var(--roman); line-height: 1.05; }
  .sous-titre { font-style: italic; color: var(--muted); }
  .genres { font-size: 13px; color: var(--muted); text-transform: uppercase; letter-spacing: .5px; }
  .lien { color: var(--accent); }
  .grille { display: grid; gap: 16px; margin-top: 18px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); }
  @media (max-width: 600px) { .phare { flex-direction: column; align-items: flex-start; } }
</style>
